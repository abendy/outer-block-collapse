{
    "name": "outer-block-collapse",
    "displayName": "Outer Block Collapse",
    "description": "Collapse outermost code blocks while keeping inner content expanded",
    "version": "0.0.6",
    "engines": {
        "vscode": "^1.80.0"
    },
    "license": "MIT",
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "Outer Block Collapse",
            "properties": {
                "outerBlockCollapse.ignorePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "^@"
                    ],
                    "description": "Regular expressions for lines that should not trigger block collapse"
                }
            }
        },
        "commands": [
            {
                "command": "outer-block-collapse.collapse",
                "title": "Collapse Outer Blocks"
            }
        ],
        "keybindings": [
            {
                "command": "outer-block-collapse.collapse",
                "key": "ctrl+k ctrl+0",
                "mac": "cmd+k cmd+0",
                "when": "editorTextFocus"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^16.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^4.9.0"
    }
}